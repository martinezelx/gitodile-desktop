  "watchEvent": {
    "name": "repository-changed",
    "fields": ["projectId", "sessionEpoch", "sequence", "kind"],
    "kinds": ["worktree", "head_or_refs", "shared_repository"]
  },
  "sessionEpoch": {
    "requiredForOpenRepositoryCommands": true,
    "semanticExceptions": [
      {
        "command": "open_repository",
        "reason": "An initial open has no epoch yet; a supplied epoch must still be the current one."
      },
      {
        "command": "get_line_endings",
        "reason": "Reads the global Git configuration when no project path is supplied; supplying one requires that project's current epoch."
      }
    ]
  }
