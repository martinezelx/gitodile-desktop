{
  "schemaVersion": 3,
  "version": {
    "releasePattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
    "legacyPreviewPattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-preview\\.([1-9][0-9]*)$",
    "tagPrefix": "v",
    "metadataFiles": [
      "package.json",
      "src-tauri/Cargo.toml",
      "src-tauri/Cargo.lock",
      "src-tauri/tauri.conf.json"
    ]
  },
  "feeds": {
    "feed": "https://raw.githubusercontent.com/martinezelx/gitodile/main/updates/latest.json",
    "legacyMirrors": [
      "https://raw.githubusercontent.com/martinezelx/gitodile/main/updates/preview.json"
    ]
  },
  "targets": [
    {
      "key": "windows-x86_64",
      "releaseEnabled": true,
      "rustTarget": "x86_64-pc-windows-msvc",
      "installation": "windows_nsis_per_user",
      "firstInstallArtifact": "nsis-setup.exe",
      "updateArtifact": "nsis-setup.exe",
      "installMode": "passive",
      "automaticEligibility": "qualification_required"
    },
    {
      "key": "darwin-aarch64",
      "releaseEnabled": false,
      "rustTarget": "aarch64-apple-darwin",
      "installation": "macos_app_bundle",
      "firstInstallArtifact": "dmg",
      "updateArtifact": "app.tar.gz",
      "installMode": "replace_app_bundle",
      "automaticEligibility": "planned_disabled"
    },
    {
      "key": "darwin-x86_64",
      "releaseEnabled": false,
      "rustTarget": "x86_64-apple-darwin",
      "installation": "macos_app_bundle",
      "firstInstallArtifact": "dmg",
      "updateArtifact": "app.tar.gz",
      "installMode": "replace_app_bundle",
      "automaticEligibility": "planned_disabled"
    },
    {
      "key": "linux-x86_64",
      "releaseEnabled": true,
      "rustTarget": "x86_64-unknown-linux-gnu",
      "installation": "linux_appimage",
      "firstInstallArtifact": "AppImage",
      "updateArtifact": "AppImage",
      "installMode": "replace_writable_appimage",
      "automaticEligibility": "qualification_required"
    }
  ],
  "manualOnlyInstallations": [
    "linux_deb",
    "linux_rpm",
    "managed_package",
    "mounted_image",
    "read_only_installation",
    "windows_msi",
    "windows_machine_wide",
    "mac_app_store",
    "microsoft_store",
    "snap",
    "flatpak",
    "aur",
    "unknown_or_unsupported"
  ],
  "states": [
    "idle",
    "checking",
    "current",
    "available",
    "downloading",
    "verifying",
    "ready",
    "blocked",
    "installing",
    "cancelled",
    "unavailable",
    "failed"
  ],
  "errors": [
    "offline",
    "timeout",
    "http_status",
    "feed_unavailable",
    "invalid_manifest",
    "invalid_version",
    "target_unavailable",
    "unsupported_installation",
    "automatic_update_not_enabled",
    "read_only_installation",
    "notes_too_large",
    "payload_too_large",
    "truncated_download",
    "signature_invalid",
    "insufficient_space",
    "install_blocked",
    "install_handoff_failed",
    "post_install_unconfirmed",
    "internal"
  ],
  "bounds": {
    "manifestBytes": 262144,
    "remoteNotesBytes": 16384,
    "platformEntries": 8,
    "signatureBytes": 4096,
    "artifactBytes": 268435456,
    "checkTimeoutSeconds": 15,
    "downloadIdleTimeoutSeconds": 30,
    "downloadTotalTimeoutSeconds": 1800,
    "redirects": 5,
    "retainedCandidates": 1
  },
  "versionCases": [
    {
      "name": "same release",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.3.0",
      "targetPresent": true,
      "expected": "current"
    },
    {
      "name": "older release",
      "installedVersion": "0.3.1",
      "candidateVersion": "0.3.0",
      "targetPresent": true,
      "expected": "current"
    },
    {
      "name": "newer release",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.3.1",
      "targetPresent": true,
      "expected": "available"
    },
    {
      "name": "a legacy preview install is offered the release that follows it",
      "installedVersion": "0.2.0-preview.12",
      "candidateVersion": "0.3.0",
      "targetPresent": true,
      "expected": "available"
    },
    {
      "name": "a legacy preview install refuses an older release",
      "installedVersion": "0.2.0-preview.12",
      "candidateVersion": "0.1.0",
      "targetPresent": true,
      "expected": "current"
    },
    {
      "name": "missing target is not current",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.3.1",
      "targetPresent": false,
      "expected": "target_unavailable"
    },
    {
      "name": "a prerelease in the feed is rejected",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.4.0-preview.1",
      "targetPresent": true,
      "expected": "invalid_version"
    },
    {
      "name": "a legacy preview install rejects a prerelease too",
      "installedVersion": "0.2.0-preview.12",
      "candidateVersion": "0.2.0-preview.13",
      "targetPresent": true,
      "expected": "invalid_version"
    },
    {
      "name": "alpha suffix is unsupported",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.4.0-alpha.1",
      "targetPresent": true,
      "expected": "invalid_version"
    },
    {
      "name": "build metadata is unsupported",
      "installedVersion": "0.3.0",
      "candidateVersion": "0.3.1+build.7",
      "targetPresent": true,
      "expected": "invalid_version"
    },
    {
      "name": "an installed preview zero is not a version",
      "installedVersion": "0.3.0-preview.0",
      "candidateVersion": "0.3.1",
      "targetPresent": true,
      "expected": "invalid_version"
    }
  ],
  "metadataCases": [
    {
      "name": "release metadata agrees",
      "versions": [
        "0.3.0",
        "0.3.0",
        "0.3.0",
        "0.3.0"
      ],
      "tag": "v0.3.0",
      "feedVersion": "0.3.0",
      "expected": "valid"
    },
    {
      "name": "npm and Cargo mismatch",
      "versions": [
        "0.3.0",
        "0.3.1",
        "0.3.0",
        "0.3.0"
      ],
      "tag": "v0.3.0",
      "feedVersion": "0.3.0",
      "expected": "metadata_mismatch"
    },
    {
      "name": "tag mismatch",
      "versions": [
        "0.3.0",
        "0.3.0",
        "0.3.0",
        "0.3.0"
      ],
      "tag": "v0.3.1",
      "feedVersion": "0.3.0",
      "expected": "metadata_mismatch"
    },
    {
      "name": "feed mismatch",
      "versions": [
        "0.3.0",
        "0.3.0",
        "0.3.0",
        "0.3.0"
      ],
      "tag": "v0.3.0",
      "feedVersion": "0.3.1",
      "expected": "metadata_mismatch"
    },
    {
      "name": "a preview is never released",
      "versions": [
        "0.3.0-preview.2",
        "0.3.0-preview.2",
        "0.3.0-preview.2",
        "0.3.0-preview.2"
      ],
      "tag": "v0.3.0-preview.2",
      "feedVersion": "0.3.0-preview.2",
      "expected": "invalid_version"
    }
  ]
}
