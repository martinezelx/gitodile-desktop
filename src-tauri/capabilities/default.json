{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal permissions for the main GitOdile window. `opener:allow-open-url` enables the command but carries no scope of its own, so the two destinations the app can actually open are listed explicitly: the public issue tracker and Git's own download pages.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/martinezelx/gitodile-feedback/*" },
        { "url": "https://git-scm.com/download/*" }
      ]
    },
    "os:allow-locale",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch"
  ]
}
